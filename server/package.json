{
  "name": "ori-capture-analysis-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "./scripts/dev-keychain.sh",
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "test:corpus-report": "node scripts/evaluate-synthetic-corpus.mjs",
    "test:labeled-report": "node scripts/evaluate-labeled-analysis.mjs",
    "check:kernel-restore": "node scripts/check-kernel-restore.mjs",
    "test:postgres-real": "node --test test/postgres_real_integration.test.js",
    "test:image-live": "node scripts/verify-recipe-image.mjs",
    "test:dining-image-live": "node scripts/verify-dining-images.mjs",
    "test:fashion-image-live": "node scripts/verify-fashion-images.mjs",
    "test:beauty-image-live": "node scripts/verify-beauty-images.mjs",
    "test:travel-image-live": "node scripts/verify-travel-images.mjs",
    "test:life-tip-image-live": "node scripts/verify-life-tip-image.mjs",
    "test:shopping-image-live": "node scripts/verify-shopping-images.mjs",
    "test:shopping-basket-image-live": "node scripts/verify-shopping-basket-image.mjs",
    "migrate:kernel-state": "node scripts/migrate-kernel-state.mjs",
    "import:kernel-json": "node scripts/import-kernel-json.mjs",
    "test:health-image-live": "node scripts/verify-health-image.mjs",
    "test:scenario-variations-live": "node scripts/verify-scenario-variations.mjs",
    "test:watch": "node --test --watch test/*.test.js"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
